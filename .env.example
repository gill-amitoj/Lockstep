# Copy to .env and fill in real values. .env is git-ignored.

# Database (also used by docker-compose.yml to create the Postgres user)
DB_URL=jdbc:postgresql://localhost:5432/lockstep_ledger
DB_USERNAME=lockstep
DB_PASSWORD=change-me

# JWT signing key: at least 32 bytes. The app refuses to start without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional: the first ADMIN user, created at startup if it doesn't exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional overrides
# RECONCILIATION_INTERVAL=PT1H
# LOG_FORMAT=          (empty = plain-text logs instead of JSON)
